{
    "name": "sepehr-meeting",
    "version": "1.0.0",
    "description": "Sepehr Meeting - self-hosted WebRTC video conferencing (SFU)",
    "main": "app/src/Server.js",
    "scripts": {
        "test": "mocha tests/*.js",
        "start": "node app/src/Server.js",
        "dev": "node --watch app/src/Server.js",
        "ssl:dev": "node scripts/generate-dev-cert.js",
        "debug": "DEBUG='mediasoup*' node app/src/Server.js",
        "lang": "node scripts/extract-ui-lang.js",
        "lang:translate": "node scripts/translate-missing-lang.js",
        "lang:auto": "npm run lang && npm run lang:translate",
        "build:mediasoup-client": "npx esbuild node_modules/mediasoup-client/lib/index.js --bundle --minify --format=iife --global-name=mediasoupClient --outfile=public/sfu/MediasoupClient.js --platform=browser",
        "postinstall": "npm run build:mediasoup-client",
        "lint": "npx prettier --write .",
        "mailpit:up": "docker-compose -f docker-compose-mailpit.yml up -d",
        "mailpit:down": "docker-compose -f docker-compose-mailpit.yml down",
        "docker:build": "docker build --tag sepehr/meeting:latest .",
        "docker:rmi": "docker image prune -f",
        "docker:push": "docker push sepehr/meeting:latest",
        "docker:pull": "docker pull sepehr/meeting:latest",
        "docker:rmc": "docker container rm sepehrmeet --force",
        "docker:run": "docker run -d --init --stop-timeout 35 -p 40000-40100:40000-40100 -p 3010:3010 -v ./.env:/src/.env -v ./app/src/config.js:/src/app/src/config.js:ro --name sepehrmeet sepehr/meeting:latest",
        "docker:run-vm": "docker run -d --init --stop-timeout 35 -p 40000-40100:40000-40100 -p 3010:3010 -v ./.env:/src/.env -v ./app/:/src/app/:ro -v ./public/:/src/public/:ro --name sepehrmeet sepehr/meeting:latest",
        "docker:start": "docker start sepehrmeet",
        "docker:stop": "docker stop sepehrmeet",
        "rtmp:start": "docker-compose -f rtmpServers/nginx-rtmp/docker-compose.yml up -d",
        "rtmp:stop": "docker-compose -f rtmpServers/nginx-rtmp/docker-compose.yml down",
        "rtmp:restart": "docker-compose -f rtmpServers/nginx-rtmp/docker-compose.yml down && docker-compose -f rtmpServers/nginx-rtmp/docker-compose.yml up -d",
        "rtmp:logs": "docker logs -f sepehr-rtmp",
        "nms:node:start": "node rtmpServers/node-media-server/src/server.js",
        "nms:start": "docker-compose -f rtmpServers/node-media-server/docker-compose.yml up -d",
        "nms:stop": "docker-compose -f rtmpServers/node-media-server/docker-compose.yml down",
        "nms:restart": "docker-compose -f rtmpServers/node-media-server/docker-compose.yml down && docker-compose -f rtmpServers/node-media-server/docker-compose.yml up -d",
        "nms:logs": "docker logs -f sepehr-nms"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/sepehrsdq/Sepehr-Meeting.git"
    },
    "keywords": [
        "webrtc",
        "sfu",
        "mediasoup",
        "video-conference",
        "sepehr"
    ],
    "author": "Sepehr Seddiq",
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "node": ">=24.22.1"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1164.0",
        "@aws-sdk/lib-storage": "^3.1164.0",
        "@mattermost/client": "11.9.0",
        "@ngrok/ngrok": "1.7.0",
        "@sentry/node": "^11.11.0",
        "async-mutex": "^0.5.0",
        "axios": "^1.21.1",
        "chokidar": "^6.0.0",
        "colors": "1.4.0",
        "compression": "1.8.2",
        "cors": "2.8.6",
        "crypto-js": "4.2.0",
        "discord.js": "^14.28.1",
        "dompurify": "^3.4.17",
        "dotenv": "^18.0.10",
        "express": "5.3.0",
        "express-openid-connect": "^3.4.0",
        "express-rate-limit": "^8.7.3",
        "he": "^2.0.0",
        "helmet": "^8.3.0",
        "httpolyglot": "0.1.2",
        "ical-generator": "^11.1.3",
        "ioredis": "^6.0.0",
        "js-yaml": "^5.5.0",
        "jsdom": "^31.0.0",
        "jsonwebtoken": "^9.0.3",
        "mediasoup": "^3.32.2",
        "mediasoup-client": "3.26.0",
        "mime-types": "^3.0.2",
        "node-windows": "^1.0.0-beta.8",
        "nodemailer": "^10.4.0",
        "openai": "^7.54.0",
        "qs": "6.17.1",
        "sanitize-filename": "^1.6.5",
        "sdp-transform": "^3.0.0",
        "socket.io": "4.8.4",
        "swagger-ui-express": "5.0.1",
        "uuid": "14.0.3"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "mocha": "^12.0.3",
        "node-fetch": "^3.3.2",
        "prettier": "3.9.10",
        "proxyquire": "^2.1.3",
        "should": "^13.2.3",
        "sinon": "^22.1.0"
    },
    "allowScripts": {
        "mediasoup": true,
        "esbuild": true,
        "@scarf/scarf": false
    },
    "homepage": "https://github.com/sepehrsdq/Sepehr-Meeting",
    "bugs": {
        "url": "https://github.com/sepehrsdq/Sepehr-Meeting/issues"
    }
}
